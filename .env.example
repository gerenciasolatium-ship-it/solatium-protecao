# =========================================================================
# PROTEÇÃO SOLATIUM — variáveis de ambiente (seção 7 do CLAUDE.md)
# Copie para .env e preencha. Nunca comite o .env real.
# =========================================================================

# --- Núcleo / Backend ---
NODE_ENV=development
PORT=3000
# URL do Postgres — OBRIGATÓRIA (Prisma; a API não sobe sem ela).
# No Railway: adicione o plugin PostgreSQL e referencie ${{Postgres.DATABASE_URL}}
# nas Variables do serviço backend.
DATABASE_URL=postgresql://solatium:solatium@localhost:5432/solatium?schema=public
# URL do Redis (filas BullMQ)
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_REFRESH_TTL=7d

# --- CORS / Frontends ---
APP_LOJA_URL=http://localhost:5173
APP_ADMIN_URL=http://localhost:5174

# --- Swagger em produção (protege /docs) ---
SWAGGER_USER=solatium
SWAGGER_PASSWORD=troque-em-producao

# =========================================================================
# INTEGRAÇÕES — stubs nesta sprint (S2+). Deixe em branco por enquanto.
# =========================================================================

# --- Pagamentos (Asaas) — S3 ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- WhatsApp (Digisac) — S3 ---
DIGISAC_TOKEN=
DIGISAC_URL=

# --- Email (Resend) — S3 ---
RESEND_API_KEY=

# --- Storage (Cloudflare R2) — S2 ---
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Seguradora (definir após contrato) ---
SEGURADORA_NOME=
SEGURADORA_APOLICE=
SEGURADORA_PROCESSO_SUSEP=
