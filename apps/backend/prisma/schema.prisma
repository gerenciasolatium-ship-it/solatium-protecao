// Proteção Solatium — schema completo (CLAUDE.md seção 4).
// Nesta Sprint 1 só os cadastros base (M1) têm CRUD; as demais tabelas já
// existem para não quebrar migrations nas próximas sprints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================
enum Role {
  ADMIN
  OPERADOR
  LOJA_ADMIN
  LOJA_VENDEDOR
}

enum LojaStatus {
  ATIVA
  INATIVA
  EM_REVISAO
}

enum PlanoPeriodicidade {
  MENSAL
  ANUAL
}

enum VistoriaStatus {
  PENDENTE
  APROVADA
  EM_ANALISE
  REPROVADA
}

enum CertificadoStatus {
  ATIVO
  SUSPENSO
  CANCELADO
  EXPIRADO
}

enum PagamentoTipo {
  PIX
  CARTAO
  BOLETO
}

// Forma contratada no checkout (S3). CARTAO_RECORRENTE = assinatura mensal;
// CARTAO_ANUAL = anual à vista ou parcelado no cartão.
enum FormaPagamento {
  PIX
  CARTAO_RECORRENTE
  CARTAO_ANUAL
  BOLETO
}

enum ContratoStatus {
  AGUARDANDO_PAGAMENTO
  ATIVO
  CANCELADO
}

enum PagamentoStatus {
  PENDENTE
  CONFIRMADO
  VENCIDO
  ESTORNADO
  // Cobrança substituída no balcão ("não perder venda") e cancelada no provedor.
  CANCELADO
}

enum SinistroStatus {
  ABERTO
  DOCUMENTACAO_PENDENTE
  EM_ANALISE
  APROVADO
  NEGADO
}

enum VoucherStatus {
  EMITIDO
  RESGATADO
  EXPIRADO
}

// --- M12: Financeiro / comissões ---
enum ModoPagamentoComissao {
  SPLIT_INSTANTANEO
  REPASSE_PROGRAMADO
}

enum ComissaoTipo {
  LOJA
  CORRETAGEM
}

enum ComissaoRegime {
  ANTECIPADA
  PRO_RATA
}

enum ComissaoStatus {
  PREVISTA
  CREDITADA
  PARCIAL_ESTORNADA
  ESTORNADA
}

enum LancamentoTipo {
  CREDITO
  DEBITO_CLAWBACK
  AJUSTE
}

enum RepasseStatus {
  ABERTO
  PROCESSANDO
  PAGO
  FALHA
}

// ===========================================================================
// M1 — CADASTROS BASE
// ===========================================================================
model Loja {
  id             String     @id @default(uuid())
  nome           String
  cnpj           String     @unique
  email          String?
  telefone       String?
  responsavelNome String?
  // Endereço
  cep            String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?
  latitude       Float?
  longitude      Float?
  // Conta bancária p/ split Asaas (S3)
  bancoNome      String?
  bancoAgencia   String?
  bancoConta     String?
  bancoTipoConta String?
  pixChave       String?
  asaasWalletId  String?
  comissaoPct    Decimal    @default(0.30) @db.Decimal(5, 4)
  // M12: como as comissões desta loja são liquidadas.
  modoPagamentoComissao ModoPagamentoComissao @default(SPLIT_INSTANTANEO)
  status         LojaStatus @default(ATIVA)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  usuarios      Usuario[]
  vendedores    Vendedor[]
  clientesOrigem Cliente[]
  certificados  Certificado[]
  vistorias     Vistoria[]
  vouchersResgate Voucher[] @relation("VoucherLojaResgate")
  contratos     Contrato[]
  comissoes     Comissao[]
  contaCorrente ContaCorrenteLancamento[]
  repasses      Repasse[]
  chavesApi     ParceiroChaveApi[]
  propostasExternas PropostaExterna[]
  sinistros     Sinistro[]

  @@map("lojas")
}

model Usuario {
  id              String    @id @default(uuid())
  nome            String
  email           String    @unique
  senhaHash       String
  role            Role
  ativo           Boolean   @default(true)
  refreshTokenHash String?
  lojaId          String?
  loja            Loja?     @relation(fields: [lojaId], references: [id])
  vendedor        Vendedor?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("usuarios")
}

model Vendedor {
  id        String   @id @default(uuid())
  nome      String
  cpf       String   @unique
  telefone  String?
  email     String?
  ativo     Boolean  @default(true)
  lojaId    String
  loja      Loja     @relation(fields: [lojaId], references: [id])
  // Login próprio: 1-1 com Usuario (role LOJA_VENDEDOR)
  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificados Certificado[]
  vistorias    Vistoria[]
  contratos    Contrato[]

  @@map("vendedores")
}

model Cliente {
  id               String   @id @default(uuid())
  nome             String
  cpf              String   @unique
  nascimento       DateTime?
  telefoneWhatsapp String
  email            String?
  cep              String?
  logradouro       String?
  numero           String?
  complemento      String?
  bairro           String?
  cidade           String?
  uf               String?
  lojaOrigemId     String?
  lojaOrigem       Loja?    @relation(fields: [lojaOrigemId], references: [id])
  asaasCustomerId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  aparelhos    Aparelho[]
  certificados Certificado[]
  pagamentos   Pagamento[]
  sinistros    Sinistro[]
  vistorias    Vistoria[]
  contratos    Contrato[]
  indicacoesFeitas Indicacao[] @relation("IndicacaoIndicador")
  indicacoesRecebidas Indicacao[] @relation("IndicacaoIndicado")

  @@map("clientes")
}

model Aparelho {
  id            String   @id @default(uuid())
  marca         String
  modelo        String
  // Obrigatório no cadastro (DTO); default 0 só para linhas pré-S3.
  armazenamentoGb Int    @default(0)
  cor           String?
  imei          String   @unique
  valorMercado  Decimal  @db.Decimal(12, 2)
  notaFiscalUrl String?
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  certificados Certificado[]
  vistorias    Vistoria[]
  contratos    Contrato[]

  @@map("aparelhos")
}

model Plano {
  id              String             @id @default(uuid())
  nome            String
  descricao       String?
  periodicidade   PlanoPeriodicidade @default(MENSAL)
  premioMensal    Decimal?           @db.Decimal(12, 2)
  premioAnual     Decimal?           @db.Decimal(12, 2)
  franquia        Decimal            @default(0) @db.Decimal(12, 2)
  // Fonte única da franquia (M3 PDF + M6 voucher): % do capital segurado.
  franquiaPercentual Decimal         @default(25) @db.Decimal(5, 2)
  capitalSegurado Decimal            @db.Decimal(12, 2)
  valorAparelhoMin Decimal?          @db.Decimal(12, 2)
  valorAparelhoMax Decimal?          @db.Decimal(12, 2)
  ativo           Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  certificados Certificado[]
  contratos    Contrato[]

  @@map("planos")
}

// Catálogo de referência de modelos (não é o aparelho do cliente — ver Aparelho).
// valorReferencia alimenta o capital segurado sugerido; protecaoMensal/Anual são
// os preços de venda da proteção definidos pelo admin (null = ainda não precificado).
model ModeloAparelho {
  id              String   @id @default(uuid())
  marca           String
  modelo          String
  armazenamentoGb Int
  valorReferencia Decimal  @db.Decimal(12, 2)
  protecaoMensal  Decimal? @db.Decimal(12, 2)
  protecaoAnual   Decimal? @db.Decimal(12, 2)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([marca, modelo, armazenamentoGb])
  @@map("modelos_aparelho")
}

// ===========================================================================
// M2 — VISTORIA
// ===========================================================================
model Vistoria {
  id                String         @id @default(uuid())
  aparelhoId        String
  aparelho          Aparelho       @relation(fields: [aparelhoId], references: [id])
  clienteId         String
  cliente           Cliente        @relation(fields: [clienteId], references: [id])
  vendedorId        String
  vendedor          Vendedor       @relation(fields: [vendedorId], references: [id])
  lojaId            String
  loja              Loja           @relation(fields: [lojaId], references: [id])
  codigoDinamico    String
  codigoExpiraEm    DateTime
  fotos             Json?          // [{ tipo, url, hashSha256 }]
  geolocalizacao    Json?          // { lat, lng, precisao }
  deviceFingerprint String?
  status            VistoriaStatus @default(PENDENTE)
  motivoReprova     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  certificado Certificado?
  contrato    Contrato?

  @@map("vistorias")
}

// ===========================================================================
// M4 — CONTRATO (venda no balcão: vistoria aprovada → cobrança → certificado)
// ===========================================================================
model Contrato {
  id             String         @id @default(uuid())
  vistoriaId     String         @unique
  vistoria       Vistoria       @relation(fields: [vistoriaId], references: [id])
  clienteId      String
  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  aparelhoId     String
  aparelho       Aparelho       @relation(fields: [aparelhoId], references: [id])
  planoId        String
  plano          Plano          @relation(fields: [planoId], references: [id])
  lojaId         String
  loja           Loja           @relation(fields: [lojaId], references: [id])
  vendedorId     String
  vendedor       Vendedor       @relation(fields: [vendedorId], references: [id])
  formaPagamento FormaPagamento
  parcelas       Int            @default(1)
  // Prêmio total contratado (mensal = 12x premioMensal; anual = premioAnual).
  premioTotal    Decimal        @db.Decimal(12, 2)
  // Dados da cobrança corrente pro balcão: QR Pix, copia-e-cola, link, boleto.
  checkout       Json?
  status         ContratoStatus @default(AGUARDANDO_PAGAMENTO)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  pagamentos      Pagamento[]
  certificado     Certificado?
  propostaExterna PropostaExterna?

  @@map("contratos")
}

// Série própria de numeração do bilhete: PS-AAAA-000001 (uma linha por ano).
model CertificadoSerie {
  ano     Int @id
  proximo Int @default(1)

  @@map("certificado_series")
}

// ===========================================================================
// M3 — CERTIFICADO / M7 — ENDOSSO
// ===========================================================================
model Certificado {
  id             String            @id @default(uuid())
  numero         String            @unique
  codigoValidacao String           @unique @default(uuid())
  clienteId      String
  cliente        Cliente           @relation(fields: [clienteId], references: [id])
  aparelhoId     String
  aparelho       Aparelho          @relation(fields: [aparelhoId], references: [id])
  planoId        String
  plano          Plano             @relation(fields: [planoId], references: [id])
  lojaId         String
  loja           Loja              @relation(fields: [lojaId], references: [id])
  vendedorId     String
  vendedor       Vendedor          @relation(fields: [vendedorId], references: [id])
  vistoriaId     String?           @unique
  vistoria       Vistoria?         @relation(fields: [vistoriaId], references: [id])
  // Idempotência da emissão automática: 1 contrato → no máximo 1 certificado.
  contratoId     String?           @unique
  contrato       Contrato?         @relation(fields: [contratoId], references: [id])
  formaPagamento FormaPagamento?
  vigenciaInicio DateTime
  vigenciaFim    DateTime
  carenciaAte    DateTime?
  status         CertificadoStatus @default(ATIVO)
  // Rastreio de churn (dashboards): quando e por que a cobertura foi cancelada.
  canceladoEm    DateTime?
  motivoCancelamento String?
  pdfUrl         String?
  whatsappEnviadoEm DateTime?
  emailEnviadoEm    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  endossos   Endosso[]
  pagamentos Pagamento[]
  sinistros  Sinistro[]
  cobrancasLog CobrancaLog[]
  comissoes  Comissao[]

  @@index([lojaId, status])
  @@map("certificados")
}

model Endosso {
  id              String      @id @default(uuid())
  certificadoId   String
  certificado     Certificado @relation(fields: [certificadoId], references: [id])
  aparelhoAnteriorId String?
  aparelhoNovoId  String?
  motivo          String?
  premioAnterior  Decimal?    @db.Decimal(12, 2)
  premioNovo      Decimal?    @db.Decimal(12, 2)
  pdfUrl          String?
  createdAt       DateTime    @default(now())

  comissoes Comissao[]

  @@map("endossos")
}

// ===========================================================================
// M4 — PAGAMENTOS / M5 — COBRANÇA
// ===========================================================================
model Pagamento {
  id            String          @id @default(uuid())
  clienteId     String
  cliente       Cliente         @relation(fields: [clienteId], references: [id])
  certificadoId String?
  certificado   Certificado?    @relation(fields: [certificadoId], references: [id])
  contratoId    String?
  contrato      Contrato?       @relation(fields: [contratoId], references: [id])
  asaasId       String?         @unique
  // 1ª cobrança do contrato: a confirmação dela dispara a emissão (M3).
  primeiraCobranca Boolean      @default(false)
  tipo          PagamentoTipo
  status        PagamentoStatus @default(PENDENTE)
  valor         Decimal         @db.Decimal(12, 2)
  split         Json?
  vencimento    DateTime?
  pagoEm        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  cobrancasLog CobrancaLog[]

  @@index([status, vencimento])
  @@map("pagamentos")
}

model CobrancaLog {
  id            String       @id @default(uuid())
  pagamentoId   String?
  pagamento     Pagamento?   @relation(fields: [pagamentoId], references: [id])
  certificadoId String?
  certificado   Certificado? @relation(fields: [certificadoId], references: [id])
  canal         String       // WHATSAPP | EMAIL
  template      String
  etapa         String       // D-3 | D0 | D+3 | D+7 | D+15 | D+30
  payload       Json?
  enviadoEm     DateTime     @default(now())

  @@map("cobrancas_log")
}

// ===========================================================================
// M6 — SINISTRO / VOUCHER
// ===========================================================================
model Sinistro {
  id                String         @id @default(uuid())
  certificadoId     String
  certificado       Certificado    @relation(fields: [certificadoId], references: [id])
  clienteId         String
  cliente           Cliente        @relation(fields: [clienteId], references: [id])
  // Loja de origem do certificado (denormalizada p/ sinistralidade por loja — M13).
  lojaId            String
  loja              Loja           @relation(fields: [lojaId], references: [id])
  status            SinistroStatus @default(ABERTO)
  boUrl             String?
  boData            DateTime?
  relato            String?
  alertasFraude     Json?
  motivoNegativa    String?
  decididoEm        DateTime?
  valorIndenizacao  Decimal?       @db.Decimal(12, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  voucher Voucher?

  @@index([lojaId, status])
  @@map("sinistros")
}

model Voucher {
  id            String        @id @default(uuid())
  codigo        String        @unique
  sinistroId    String        @unique
  sinistro      Sinistro      @relation(fields: [sinistroId], references: [id])
  qr            String?
  valor         Decimal       @db.Decimal(12, 2)
  validade      DateTime
  status        VoucherStatus @default(EMITIDO)
  lojaResgateId String?
  lojaResgate   Loja?         @relation("VoucherLojaResgate", fields: [lojaResgateId], references: [id])
  resgatadoEm   DateTime?
  createdAt     DateTime      @default(now())

  @@map("vouchers")
}

// ===========================================================================
// M10 — INDICAÇÃO / COMUNICAÇÃO
// ===========================================================================
model Indicacao {
  id                String    @id @default(uuid())
  codigo            String    @unique
  clienteIndicadorId String
  clienteIndicador  Cliente   @relation("IndicacaoIndicador", fields: [clienteIndicadorId], references: [id])
  clienteIndicadoId String?
  clienteIndicado   Cliente?  @relation("IndicacaoIndicado", fields: [clienteIndicadoId], references: [id])
  recompensa        String?
  convertidoEm      DateTime?
  createdAt         DateTime  @default(now())

  @@map("indicacoes")
}

model NotificacaoLog {
  id        String   @id @default(uuid())
  canal     String   // WHATSAPP | EMAIL | SMS
  template  String
  status    String   // ENVIADO | FALHA
  payload   Json?
  enviadoEm DateTime @default(now())

  @@map("notificacoes_log")
}

// ===========================================================================
// M9 — BORDERÔ
// ===========================================================================
model Bordero {
  id           String   @id @default(uuid())
  referenciaMes String  // YYYY-MM
  dados        Json
  arquivoUrl   String?
  geradoEm     DateTime @default(now())

  @@map("borderos")
}

// ===========================================================================
// M12 — FINANCEIRO: comissões, conta-corrente e clawback
// ===========================================================================
model Comissao {
  id             String         @id @default(uuid())
  lojaId         String
  loja           Loja           @relation(fields: [lojaId], references: [id])
  certificadoId  String?
  certificado    Certificado?   @relation(fields: [certificadoId], references: [id])
  endossoId      String?
  endosso        Endosso?       @relation(fields: [endossoId], references: [id])
  tipo           ComissaoTipo   @default(LOJA)
  regime         ComissaoRegime
  // valorBase = prêmio sobre o qual a comissão foi calculada; valorTotal = comissão cheia.
  valorBase      Decimal        @db.Decimal(12, 2)
  valorTotal     Decimal        @db.Decimal(12, 2)
  parcelasTotais Int            @default(12)
  parcelasPagas  Int            @default(0)
  // valorEstornado acumula clawbacks já lançados sobre esta comissão.
  valorEstornado Decimal        @default(0) @db.Decimal(12, 2)
  status         ComissaoStatus @default(PREVISTA)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lancamentos ContaCorrenteLancamento[]

  @@index([lojaId])
  @@map("comissoes")
}

model ContaCorrenteLancamento {
  id             String         @id @default(uuid())
  // Ordem monotônica do livro-razão (uuid não ordena; createdAt colide no ms).
  seq            Int            @unique @default(autoincrement())
  lojaId         String
  loja           Loja           @relation(fields: [lojaId], references: [id])
  tipo           LancamentoTipo
  // valor SEMPRE positivo (magnitude); o sinal é dado por `tipo`. saldoApos = saldo resultante.
  valor          Decimal        @db.Decimal(12, 2)
  saldoApos      Decimal        @db.Decimal(12, 2)
  referencia     String
  comissaoId     String?
  comissao       Comissao?      @relation(fields: [comissaoId], references: [id])
  memoriaCalculo Json?
  createdAt      DateTime       @default(now())

  @@index([lojaId, createdAt])
  @@map("conta_corrente_lancamentos")
}

model Repasse {
  id              String        @id @default(uuid())
  lote            String
  lojaId          String
  loja            Loja          @relation(fields: [lojaId], references: [id])
  valorLiquido    Decimal       @db.Decimal(12, 2)
  status          RepasseStatus @default(ABERTO)
  comprovanteUrl  String?
  referenciaInicio DateTime?
  referenciaFim   DateTime?
  createdAt       DateTime      @default(now())

  @@index([lojaId])
  @@map("repasses")
}

// ===========================================================================
// AUDITORIA (global)
// ===========================================================================
model AuditLog {
  id         String   @id @default(uuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  acao       String   // CREATE | UPDATE | DELETE
  entidade   String
  entidadeId String?
  antes      Json?
  depois     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entidade, entidadeId])
  @@map("audit_log")
}

// ===========================================================================
// M11 — API DE PARCEIROS (CRM do parceiro → proposta pré-preenchida)
// ===========================================================================
enum StatusPropostaExterna {
  ABERTA // criada pelo CRM, aguardando o vendedor abrir o link
  UTILIZADA // o wizard do app-loja já carregou os dados
  CONCLUIDA // virou contrato
  EXPIRADA
}

model ParceiroChaveApi {
  id          String    @id @default(uuid())
  lojaId      String
  loja        Loja      @relation(fields: [lojaId], references: [id])
  nome        String // ex.: "CRM interno da OnePurple"
  // A chave completa (psk_...) só é exibida na criação; guardamos o SHA-256.
  prefixo     String // primeiros caracteres, p/ o admin identificar a chave
  chaveHash   String    @unique
  ativo       Boolean   @default(true)
  ultimoUsoEm DateTime?
  createdAt   DateTime  @default(now())

  propostas PropostaExterna[]

  @@map("parceiro_chaves_api")
}

model PropostaExterna {
  id                String                @id @default(uuid())
  codigo            String                @unique // token do link pré-preenchido
  lojaId            String
  loja              Loja                  @relation(fields: [lojaId], references: [id])
  chaveApiId        String
  chaveApi          ParceiroChaveApi      @relation(fields: [chaveApiId], references: [id])
  referenciaExterna String? // id do negócio/cliente no CRM do parceiro
  payload           Json // { cliente, aparelho? } validados na entrada
  status            StatusPropostaExterna @default(ABERTA)
  utilizadaEm       DateTime?
  contratoId        String?               @unique
  contrato          Contrato?             @relation(fields: [contratoId], references: [id])
  expiraEm          DateTime
  createdAt         DateTime              @default(now())

  @@index([lojaId, status])
  @@map("propostas_externas")
}
